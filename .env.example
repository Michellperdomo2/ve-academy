# ============================================================
# V&E Academy — variables de entorno
# Copia este archivo:  cp .env.example .env   y cambia los valores.
# NUNCA subas el archivo .env al repositorio.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=ve_academy
POSTGRES_USER=ve_user
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_PORT=5432

# --- Seguridad (genera una clave: python -c "import secrets; print(secrets.token_urlsafe(48))") ---
# El backend rechaza claves que empiecen por "change-me".
JWT_SECRET_KEY=change-me-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- Ambiente ---
ENVIRONMENT=development
TZ=America/Bogota
BACKEND_PORT=8000
FRONTEND_PORT=4200
CORS_ORIGINS=http://localhost:4200
FRONTEND_URL=http://localhost:4200
# true: la imagen del backend incluye pytest para correr pruebas dentro del contenedor
BACKEND_INSTALL_DEV=true

# --- Datos iniciales ---
SEED_CONTENT=true
# Crea docente.demo, acudiente.demo, sofia.demo y mateo.demo (sin progreso inventado). Usar solo en desarrollo.
SEED_DEMO_USERS=true
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# --- Correo para recuperar contraseñas (opcional; si se deja vacío, la función informa que no está habilitada) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- pgAdmin (perfil opcional "tools") ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-pgadmin
